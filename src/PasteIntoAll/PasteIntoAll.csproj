<Project>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>PasteIntoAll</RootNamespace>
    <AssemblyName>PasteIntoAll</AssemblyName>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>Paste into all</AssemblyTitle>
    <Product>Paste into all</Product>
    <Company>Paste into all</Company>
    <Version>1.3.0</Version>
    <UICulture>en-US</UICulture>

    <!-- VSIX / VS SDK -->
    <CreateVsixContainer>true</CreateVsixContainer>
    <DeployExtension>false</DeployExtension>
    <CopyVsixManifestToOutput>true</CopyVsixManifestToOutput>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <!-- Without this the pkgdef has no CodeBase and VS cannot find the assembly. -->
    <RegisterWithCodebase>true</RegisterWithCodebase>
    <UseCodebase>true</UseCodebase>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>false</IncludeDebugSymbolsInLocalVSIXDeployment>

    <!-- The extension is installed for the current user; keeps deployment simple. -->
    <CreateVsixContainerDependsOn>GenerateFileManifest;GenerateResourcePackagesManifest</CreateVsixContainerDependsOn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="18.12.1606" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.12.1606" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Design" />
  </ItemGroup>

  <!-- Localized VSCT text is merged into these resources; VS loads the merged
       Menus.ctmenu from the matching satellite assembly at runtime. -->
  <ItemGroup>
    <EmbeddedResource Update="Resources.resx">
      <LogicalName>PasteIntoAll.Resources.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources.en-US.resx">
      <MergeWithCTO>true</MergeWithCTO>
      <LogicalName>PasteIntoAll.Resources.en-US.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources.ru-RU.resx">
      <MergeWithCTO>true</MergeWithCTO>
      <LogicalName>PasteIntoAll.Resources.ru-RU.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <VSCTCompile Include="VSCommandTable.en-US.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
      <SubType>Designer</SubType>
    </VSCTCompile>
    <VSCTCompile Include="VSCommandTable.ru-RU.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
  </ItemGroup>

  <ItemGroup>
    <Content Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </Content>
    <Content Include="Resources\icon-128.png">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="Resources\preview-200.png">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="ru-RU\Extension.vsixlangpack">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
  </ItemGroup>

  <!-- SDK targets first (they define OutDir/IntermediateOutputPath/TargetPath), VSSDK targets after them. -->
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

  <!-- VSSDK build tools come from the Microsoft.VSSDK.BuildTools NuGet package and set VSToolsPath. -->
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets" Condition="Exists('$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets')" />

  <!-- `msbuild /t:Build` (and the IDE build) must produce the .vsix. -->
  <Target Name="BuildVsixContainer" AfterTargets="Build" DependsOnTargets="GeneratePkgDef;CreateVsixContainer" />

</Project>
