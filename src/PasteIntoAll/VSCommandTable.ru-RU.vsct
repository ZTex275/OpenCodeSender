<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable"
              xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />

  <Commands package="guidPasteIntoAllPackage">
    <Groups>
      <Group guid="guidPasteIntoAllCmdSet" id="ToolsMenuGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS" />
      </Group>
      <Group guid="guidPasteIntoAllCmdSet" id="EditorContextMenuGroup" priority="0x0500">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_CODEWIN" />
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidPasteIntoAllCmdSet" id="cmdidSendSelection" priority="0x0100" type="Button">
        <Parent guid="guidPasteIntoAllCmdSet" id="ToolsMenuGroup" />
        <Icon guid="guidImages" id="bmpSend" />
        <Strings>
          <CommandName>PasteIntoAll</CommandName>
          <ButtonText>Вставить в приложение</ButtonText>
          <ToolTipText>Вставить выделенный код в целевое приложение (Ctrl+Alt+Shift+O)</ToolTipText>
        </Strings>
      </Button>
    </Buttons>

    <Bitmaps>
      <Bitmap guid="guidImages" href="Resources\command-16.png" usedList="bmpSend" />
    </Bitmaps>
  </Commands>

  <!-- The same command is placed in the editor context menu instead of being
       duplicated, so Visual Studio renders the shortcut of the command in both
       menus (Ctrl+Alt+Shift+O on the right). -->
  <CommandPlacements>
    <CommandPlacement guid="guidPasteIntoAllCmdSet" id="cmdidSendSelection" priority="0x0100">
      <Parent guid="guidPasteIntoAllCmdSet" id="EditorContextMenuGroup" />
    </CommandPlacement>
  </CommandPlacements>

  <KeyBindings>
    <KeyBinding guid="guidPasteIntoAllCmdSet" id="cmdidSendSelection"
                editor="guidVSStd97" key1="O" mod1="CONTROL ALT SHIFT" />
  </KeyBindings>

  <Symbols>
    <GuidSymbol name="guidPasteIntoAllPackage" value="{8f9d1a2c-6b3e-4c7a-9e21-5a0d3b8c4f61}" />

    <GuidSymbol name="guidPasteIntoAllCmdSet" value="{3c7a1f84-2d95-4b8e-a174-6c0e9f2b5d38}">
      <IDSymbol name="ToolsMenuGroup" value="0x1020" />
      <IDSymbol name="EditorContextMenuGroup" value="0x1021" />
      <IDSymbol name="cmdidSendSelection" value="0x0100" />
    </GuidSymbol>

    <GuidSymbol name="guidImages" value="{a1f3c5e7-2b4d-4f60-8c9a-1d2e3f405162}">
      <IDSymbol name="bmpSend" value="1" />
    </GuidSymbol>
  </Symbols>
</CommandTable>
